{
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "name": "Amex Autofill",
  "version": "0.4.0",
  "description": "登録情報を端末内で暗号化し、対応申込フォームへ明示操作で入力します。申込送信は行いません。",
  "permissions": ["storage", "scripting"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.americanexpress.com/en-us/credit-cards/apply/business/business-platinum-charge-card/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "incognito": "not_allowed",
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
